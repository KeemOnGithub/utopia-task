{
  "name": "sejuk-operations",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run typecheck && npm run build -w apps/web && esbuild apps/api/src/server.ts --bundle --platform=node --format=esm --packages=external --alias:@sejuk/contracts=./packages/contracts/src --outfile=build/server.mjs",
    "start": "node --env-file-if-exists=.env build/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx db/migrate.ts",
    "account": "node --env-file-if-exists=.env --import tsx apps/api/src/cli/accounts.ts"
  },
  "dependencies": {"@fastify/static":"^10.1.7","argon2":"^0.44.0","fastify":"^5.6.1","ipaddr.js":"^2.2.0","pg":"^8.16.3","react":"^19.2.0","react-dom":"^19.2.0","react-router-dom":"^7.9.4"},
  "devDependencies": {"@playwright/test":"^1.56.1","@tailwindcss/vite":"^4.1.16","@testing-library/jest-dom":"^6.9.1","@testing-library/react":"^16.3.0","@testing-library/user-event":"^14.6.1","@types/node":"^24.9.1","@types/pg":"^8.15.5","@types/react":"^19.2.2","@types/react-dom":"^19.2.2","@vitejs/plugin-react":"^5.0.4","concurrently":"^9.2.1","embedded-postgres":"^17.9.0-beta.16","esbuild":"^0.25.12","eslint":"^9.38.0","jsdom":"^27.0.1","tailwindcss":"^4.1.16","tsx":"^4.20.6","typescript":"^5.9.3","typescript-eslint":"^8.46.2","vite":"^7.1.12","vitest":"^5.0.5"}
}
